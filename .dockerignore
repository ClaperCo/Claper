.dockerignore
# there are valid reasons to keep the .git, namely so that you can get the
# current commit hash
#.git
.log
tmp

# Mix artifacts
_build
deps
*.ez
releases

# Generate on crash by the VM
erl_crash.dump

# Static artifacts
node_modules

assets/node_modules/
deps/
assets/yarn.lock

# Local uploads and compiled static assets (rebuilt in the image)
priv/static/uploads
priv/static/assets
priv/static/cache_manifest.json