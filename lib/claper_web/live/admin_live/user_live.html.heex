<%= case @live_action do %>
  <% :index -> %>
    <div>
      <h1 class="text-3xl font-bold mb-6">{gettext("Users")}</h1>

      <.form
        for={@form}
        class="flex flex-col sm:flex-row gap-3 sm:[&>div]:basis-[250px]"
        phx-change="filter-users"
      >
        <Flop.Phoenix.filter_fields :let={i} form={@form} fields={@fields}>
          <ClaperWeb.CoreComponents.input
            field={i.field}
            label={i.label}
            type={i.type}
            phx-debounce="300"
            {i.rest}
          />
        </Flop.Phoenix.filter_fields>
      </.form>

      <Flop.Phoenix.table
        items={@users}
        meta={@meta}
        path={~p"/admin/users"}
        opts={[
          container: true,
          container_attrs: [class: "card bg-base-100 shadow-md overflow-x-auto my-5"],
          no_results_content: ~H"""
          <p class="text-center py-10">{gettext("No users found")}</p>
          """,
          table_attrs: [class: "table table-zebra w-full"],
          symbol_asc: ~H"""
          <span aria-hidden="true"><ClaperWeb.Icons.arrow_up /></span>
          """,
          symbol_desc: ~H"""
          <span aria-hidden="true"><ClaperWeb.Icons.arrow_down /></span>
          """
        ]}
      >
        <:col :let={user} label={gettext("Email")} field={:email}>
          <.link navigate={~p"/admin/users/#{user}"} class="link font-bold">
            {user.email}
          </.link>
        </:col>
        <:col :let={user} label={gettext("First name")} field={:first_name}>
          {user.first_name || "—"}
        </:col>
        <:col :let={user} label={gettext("Last name")} field={:last_name}>
          {user.last_name || "—"}
        </:col>
        <:col :let={user} label={gettext("Role")} field={:role_id}>
          {if user.role, do: user.role.name, else: gettext("No role")}
        </:col>
        <:col :let={user} label={gettext("Status")} field={:confirmed_at}>
          <%= cond do %>
            <% user.deleted_at -> %>
              <span class="badge badge-error">{gettext("Disabled")}</span>
            <% user.confirmed_at -> %>
              <span class="badge badge-success">{gettext("Confirmed")}</span>
            <% true -> %>
              <span class="badge badge-warning">{gettext("Unconfirmed")}</span>
          <% end %>
        </:col>
        <:col :let={user} label={gettext("Created")} field={:inserted_at}>
          {Calendar.strftime(user.inserted_at, "%Y-%m-%d %H:%M")}
        </:col>
      </Flop.Phoenix.table>

      <div class="flex justify-end mt-4">
        <ClaperWeb.CoreComponents.pagination meta={@meta} path={~p"/admin/users"} />
      </div>
    </div>
  <% :show -> %>
    <div>
      <div>
        <div class="flex justify-between items-center mb-6">
          <h1 class="text-3xl font-bold">{gettext("User details")}</h1>
          <div class="flex space-x-3">
            <.link navigate={~p"/admin/users"} class="btn btn-outline btn-sm">
              {gettext("Back to users")}
            </.link>
            <.link navigate={~p"/admin/users/#{@user}/edit"} class="btn btn-primary btn-sm">
              {gettext("Edit")}
            </.link>
            <button
              :if={is_nil(@user.deleted_at)}
              type="button"
              phx-click="disable"
              phx-value-id={@user.id}
              data-confirm={
                gettext(
                  "Disable this user? They will no longer be able to log in, but their data is kept."
                )
              }
              class="btn btn-outline btn-sm"
            >
              {gettext("Disable")}
            </button>
            <button
              :if={@user.deleted_at}
              type="button"
              phx-click="enable"
              phx-value-id={@user.id}
              class="btn btn-outline btn-sm"
            >
              {gettext("Enable")}
            </button>
            <button
              type="button"
              phx-click="delete"
              phx-value-id={@user.id}
              data-confirm={
                gettext(
                  "Permanently delete this user and all their events? Their interactions in other events are kept anonymously. This cannot be undone."
                )
              }
              class="btn btn-error btn-outline btn-sm"
            >
              {gettext("Delete permanently")}
            </button>
          </div>
        </div>
      </div>

      <div class="mt-6">
        <.detail_card>
          <.detail_row label={gettext("First name")}>
            {@user.first_name || "—"}
          </.detail_row>
          <.detail_row label={gettext("Last name")}>
            {@user.last_name || "—"}
          </.detail_row>
          <.detail_row label={gettext("Email")}>
            <a href={"mailto:#{@user.email}"} class="link link-primary">{@user.email}</a>
          </.detail_row>
          <.detail_row label={gettext("Role")}>
            {if @user.role, do: @user.role.name, else: gettext("No role")}
          </.detail_row>
          <.detail_row label={gettext("Status")}>
            <%= cond do %>
              <% @user.deleted_at -> %>
                <span class="badge badge-error">{gettext("Disabled")}</span>
              <% @user.confirmed_at -> %>
                <span class="badge badge-success">{gettext("Confirmed")}</span>
              <% true -> %>
                <span class="badge badge-warning">{gettext("Unconfirmed")}</span>
            <% end %>
          </.detail_row>
          <.detail_row label={gettext("Created At")}>
            {format_admin_timestamp(@user.inserted_at)}
          </.detail_row>
          <.detail_row label={gettext("Last Updated")}>
            {format_admin_timestamp(@user.updated_at)}
          </.detail_row>
          <.detail_row label={gettext("Confirmed At")} show={!is_nil(@user.confirmed_at)}>
            {format_admin_timestamp(@user.confirmed_at)}
          </.detail_row>
        </.detail_card>
      </div>

      <div class="mt-8">
        <h2 class="text-2xl font-bold mb-4">{gettext("Events")}</h2>

        <Flop.Phoenix.table
          id="user-events"
          items={@events}
          meta={@events_meta}
          path={@events_path}
          opts={[
            container: true,
            container_attrs: [class: "card bg-base-100 shadow-md overflow-x-auto"],
            no_results_content: ~H"""
            <p class="text-center py-10">{gettext("No events for this user.")}</p>
            """,
            table_attrs: [class: "table table-zebra w-full"],
            symbol_asc: ~H"""
            <span aria-hidden="true"><ClaperWeb.Icons.arrow_up /></span>
            """,
            symbol_desc: ~H"""
            <span aria-hidden="true"><ClaperWeb.Icons.arrow_down /></span>
            """
          ]}
        >
          <:col :let={event} label={gettext("Name")} field={:name}>
            <.link navigate={~p"/admin/events/#{event}"} class="link font-bold">
              {event.name}
            </.link>
          </:col>
          <:col :let={event} label={gettext("Code")} field={:code}>
            <span class="uppercase">{event.code}</span>
          </:col>
          <:col :let={event} label={gettext("Started At")} field={:started_at}>
            {format_admin_timestamp(event.started_at)}
          </:col>
          <:col :let={event} label={gettext("Expired At")} field={:expired_at}>
            {if event.expired_at,
              do: format_admin_timestamp(event.expired_at),
              else: gettext("Not expired")}
          </:col>
          <:col :let={event} label={gettext("Audience Peak")} field={:audience_peak}>
            <div class="badge badge-outline">{event.audience_peak || 0}</div>
          </:col>
        </Flop.Phoenix.table>

        <div class="flex justify-end mt-4">
          <ClaperWeb.CoreComponents.pagination meta={@events_meta} path={@events_path} />
        </div>
      </div>

      <div class="mt-8">
        <h2 class="text-2xl font-bold mb-4">{gettext("Audit Logs")}</h2>

        <Flop.Phoenix.table
          items={@audit_logs}
          meta={@audit_meta}
          path={@audit_path}
          opts={[
            container: true,
            container_attrs: [class: "card bg-base-100 shadow-md overflow-x-auto"],
            no_results_content: ~H"""
            <p class="text-center py-10">{gettext("No audit logs for this user.")}</p>
            """,
            table_attrs: [class: "table table-zebra w-full"],
            symbol_asc: ~H"""
            <span aria-hidden="true"><ClaperWeb.Icons.arrow_up /></span>
            """,
            symbol_desc: ~H"""
            <span aria-hidden="true"><ClaperWeb.Icons.arrow_down /></span>
            """
          ]}
        >
          <:col :let={log} label={gettext("ID")} field={:id}>
            <.link navigate={~p"/admin/audit_logs/#{log}"} class="link font-bold">
              {log.id}
            </.link>
          </:col>
          <:col :let={log} label={gettext("Action")} field={:action}>
            <span class="badge badge-outline">{log.action}</span>
          </:col>
          <:col :let={log} label={gettext("Timestamp")} field={:inserted_at}>
            {format_admin_timestamp(log.inserted_at)}
          </:col>
          <:col
            :let={log}
            label={gettext("Metadata")}
            tbody_td_attrs={[class: "max-w-xs truncate text-sm text-base-content/70"]}
          >
            {format_audit_metadata(log.metadata)}
          </:col>
        </Flop.Phoenix.table>

        <div class="flex justify-end mt-4">
          <ClaperWeb.CoreComponents.pagination meta={@audit_meta} path={@audit_path} />
        </div>
      </div>
    </div>
  <% :new -> %>
    <div>
      <div>
        <div class="flex justify-between items-center">
          <h1 class="text-3xl font-bold">{gettext("New user")}</h1>
        </div>
      </div>

      <div class="mt-6">
        <div class="card bg-base-100 shadow-md">
          <div class="card-body">
            <.live_component
              module={ClaperWeb.AdminLive.UserLive.FormComponent}
              id="user-form"
              title={gettext("New user")}
              action={:new}
              user={@user}
              navigate={~p"/admin/users"}
            />
          </div>
        </div>
      </div>
    </div>
  <% :edit -> %>
    <div>
      <div>
        <div class="flex justify-between items-center">
          <h1 class="text-3xl font-bold">{gettext("Edit user")}</h1>
        </div>
      </div>

      <div class="mt-6">
        <div class="card bg-base-100 shadow-md">
          <div class="card-body">
            <.live_component
              module={ClaperWeb.AdminLive.UserLive.FormComponent}
              id={"user-form-#{@user.id}"}
              title={gettext("Edit user")}
              action={:edit}
              user={@user}
              navigate={~p"/admin/users"}
            />
          </div>
        </div>
      </div>
    </div>
<% end %>
