<div class="px-4 lg:px-12 pb-12 lg:pb-12 pb-36">
  <!-- Filter Bar and Actions -->
  <div class="pt-4 lg:pt-6 pb-4 lg:pb-6">
    <!-- Mobile: Search bar + Centered tabs -->
    <div class="lg:hidden mb-4">
      <form phx-submit="search" phx-change="search" class="relative">
        <div class="flex items-center gap-2 bg-white border border-gray-200 rounded-full px-4 h-10">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5 text-gray-400"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
            />
          </svg>
          <input
            type="text"
            name="search"
            placeholder={gettext("Search")}
            class="flex-1 bg-transparent border-none focus:outline-none focus:ring-0 text-sm text-gray-700 placeholder-gray-400"
            phx-debounce="300"
          />
        </div>
      </form>
    </div>
    <div class="flex lg:hidden items-center justify-center">
      <.tabs style={:boxed}>
        <:tab
          active={@active_tab == "not_expired"}
          phx-click="change-tab"
          phx-value-tab="not_expired"
        >
          {gettext("Active")}
        </:tab>
        <:tab
          active={@active_tab == "expired"}
          disabled={not @has_expired_events}
          phx-click="change-tab"
          phx-value-tab="expired"
        >
          {gettext("Done")}
        </:tab>
        <:tab
          active={@active_tab == "invited"}
          disabled={not @has_invited_events}
          phx-click="change-tab"
          phx-value-tab="invited"
        >
          {gettext("Shared with you")}
        </:tab>
      </.tabs>
    </div>

    <nav
      :if={@folder}
      id="breadcrumbs"
      aria-label={gettext("Folder path")}
      class="flex flex-wrap items-center gap-1 px-4 lg:px-0 pb-3 text-sm"
    >
      <.link patch={~p"/events"} class="link link-hover">{gettext("Events")}</.link>
      <%= for {crumb, index} <- Enum.with_index(@breadcrumbs) do %>
        <span aria-hidden="true">/</span>
        <%= if crumb.id == @folder.id do %>
          <span class="font-semibold" aria-current="page">{crumb.name}</span>
        <% else %>
          <.link patch={folder_href(Enum.take(@path, index + 1))} class="link link-hover">
            {crumb.name}
          </.link>
        <% end %>
      <% end %>
    </nav>
    
<!-- Desktop: Full layout with tabs, view toggle, and action buttons -->
    <div class="hidden lg:flex items-center justify-between gap-4">
      <!-- Left: Filter Tabs -->
      <.tabs style={:boxed}>
        <:tab
          active={@active_tab == "not_expired"}
          phx-click="change-tab"
          phx-value-tab="not_expired"
        >
          {gettext("Active")}
        </:tab>
        <:tab
          active={@active_tab == "expired"}
          disabled={not @has_expired_events}
          phx-click="change-tab"
          phx-value-tab="expired"
        >
          {gettext("Done")}
        </:tab>
        <:tab
          active={@active_tab == "invited"}
          disabled={not @has_invited_events}
          phx-click="change-tab"
          phx-value-tab="invited"
        >
          {gettext("Shared with you")}
        </:tab>
      </.tabs>
      
<!-- Right: View Toggle & Action Buttons -->
      <div class="flex items-center gap-2 flex-wrap">
        <!-- View Toggle -->
        <div
          id="view-mode-toggle"
          phx-hook="ViewModePreference"
          class="flex items-center gap-1 bg-white border border-gray-200 rounded-full p-1 h-12"
        >
          <button
            phx-click="change-view"
            phx-value-view="grid"
            class={"p-2 rounded-full transition #{if @view_mode == "grid", do: "bg-primary-50 border-b-2 border-primary-500", else: "hover:bg-gray-100"}"}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class={"w-5 h-5 #{if @view_mode == "grid", do: "text-primary-500", else: "text-secondary-500"}"}
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path
                fill-rule="evenodd"
                d="M3 6a3 3 0 0 1 3-3h2.25a3 3 0 0 1 3 3v2.25a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V6Zm9.75 0a3 3 0 0 1 3-3H18a3 3 0 0 1 3 3v2.25a3 3 0 0 1-3 3h-2.25a3 3 0 0 1-3-3V6ZM3 15.75a3 3 0 0 1 3-3h2.25a3 3 0 0 1 3 3V18a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3v-2.25Zm9.75 0a3 3 0 0 1 3-3H18a3 3 0 0 1 3 3V18a3 3 0 0 1-3 3h-2.25a3 3 0 0 1-3-3v-2.25Z"
                clip-rule="evenodd"
              />
            </svg>
          </button>
          <button
            phx-click="change-view"
            phx-value-view="list"
            class={"p-2 rounded-full transition #{if @view_mode == "list", do: "bg-primary-50 border-b-2 border-primary-500", else: "hover:bg-gray-100"}"}
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class={"w-5 h-5 #{if @view_mode == "list", do: "text-primary-500", else: "text-secondary-500"}"}
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path
                fill-rule="evenodd"
                d="M2.625 6.75a1.125 1.125 0 1 1 2.25 0 1.125 1.125 0 0 1-2.25 0Zm4.875 0A.75.75 0 0 1 8.25 6h12a.75.75 0 0 1 0 1.5h-12a.75.75 0 0 1-.75-.75ZM2.625 12a1.125 1.125 0 1 1 2.25 0 1.125 1.125 0 0 1-2.25 0ZM7.5 12a.75.75 0 0 1 .75-.75h12a.75.75 0 0 1 0 1.5h-12A.75.75 0 0 1 7.5 12Zm-4.875 5.25a1.125 1.125 0 1 1 2.25 0 1.125 1.125 0 0 1-2.25 0Zm4.875 0a.75.75 0 0 1 .75-.75h12a.75.75 0 0 1 0 1.5h-12a.75.75 0 0 1-.75-.75Z"
                clip-rule="evenodd"
              />
            </svg>
          </button>
        </div>

        <.create_folder_control
          :if={@active_tab != "invited"}
          prefix="create-folder"
          open={@creating_folder}
        />
        
<!-- Create Event Button -->
        <.link patch={new_event_href(@path)} class="btn btn-gradient">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            viewBox="0 0 20 20"
            fill="currentColor"
          >
            <path
              fill-rule="evenodd"
              d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z"
              clip-rule="evenodd"
            />
          </svg>
          <span>{gettext("Create an event")}</span>
        </.link>
      </div>
    </div>
  </div>
  
<!-- Events Grid/List -->
  <div class="relative">
    <!-- Mobile: Always list view -->
    <div role="event-list" id={"events-mobile-#{@active_tab}"} class="lg:hidden space-y-2.5">
      <%= if show_folders?(assigns) do %>
        <.folder_card
          :for={folder <- @subfolders}
          id={"folder-mobile-#{folder.id}"}
          folder={folder}
          href={folder_href(@path ++ [folder.name])}
        />
      <% end %>
      <% current_time = NaiveDateTime.utc_now() %>
      <%= for event <- @events do %>
        <.live_component
          module={ClaperWeb.EventLive.EventCardComponent}
          id={"event-mobile-#{@active_tab}-#{event.id}"}
          event={event}
          current_time={current_time}
          is_leader={@active_tab == "invited"}
          view_mode="mobile"
        />
      <% end %>
    </div>
    
<!-- Desktop: Grid or List based on view_mode -->
    <%= if @view_mode == "grid" do %>
      <!-- Grid View -->
      <div
        id="events"
        phx-update="replace"
        class="hidden lg:grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4"
      >
        <%= if show_folders?(assigns) do %>
          <.folder_card
            :for={folder <- @subfolders}
            id={"folder-#{@view_mode}-#{folder.id}"}
            folder={folder}
            href={folder_href(@path ++ [folder.name])}
            layout={@view_mode}
          />
        <% end %>
        <% current_time = NaiveDateTime.utc_now() %>
        <%= for event <- @events do %>
          <.live_component
            module={ClaperWeb.EventLive.EventCardComponent}
            id={"event-#{event.id}"}
            event={event}
            current_time={current_time}
            is_leader={@active_tab == "invited"}
            view_mode={@view_mode}
          />
        <% end %>
      </div>
    <% else %>
      <!-- List View -->
      <div role="event-list" id="events" phx-update="replace" class="hidden lg:block space-y-4">
        <%= if show_folders?(assigns) do %>
          <.folder_card
            :for={folder <- @subfolders}
            id={"folder-#{@view_mode}-#{folder.id}"}
            folder={folder}
            href={folder_href(@path ++ [folder.name])}
            layout={@view_mode}
          />
        <% end %>
        <% current_time = NaiveDateTime.utc_now() %>
        <%= for event <- @events do %>
          <.live_component
            module={ClaperWeb.EventLive.EventCardComponent}
            id={"event-#{event.id}"}
            event={event}
            current_time={current_time}
            is_leader={@active_tab == "invited"}
            view_mode={@view_mode}
          />
        <% end %>
      </div>
    <% end %>
    
<!-- Load More Button -->
    <%= if @page < @total_pages do %>
      <div class="flex justify-center my-8">
        <button phx-click="load-more" class="btn btn-soft btn-primary">
          {gettext("Load more")}
        </button>
      </div>
    <% end %>
    
<!-- Empty State -->
    <%= if Enum.count(@events) == 0 and not (show_folders?(assigns) and @subfolders != []) do %>
      <div class="w-full py-16 text-center">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-16 w-16 mx-auto text-gray-300 mb-4"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
          />
        </svg>
        <p class="text-xl text-gray-400">{gettext("Create your first event")}</p>
        <.link patch={new_event_href(@path)} class="btn btn-gradient mt-4">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-5 w-5"
            viewBox="0 0 20 20"
            fill="currentColor"
          >
            <path
              fill-rule="evenodd"
              d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z"
              clip-rule="evenodd"
            />
          </svg>
          <span>{gettext("Create an event")}</span>
        </.link>
      </div>
    <% end %>
  </div>
  
<!-- Mobile Fixed Bottom Action Buttons -->
  <div class="lg:hidden fixed bottom-0 left-0 right-0 bg-gradient-to-t from-white from-70% via-white via-85% to-transparent px-4 pt-12 pb-6 z-20">
    <div class="flex flex-col gap-2.5">
      <.create_folder_control
        :if={@active_tab != "invited"}
        prefix="create-folder-mobile"
        open={@creating_folder}
      />
      <.link patch={new_event_href(@path)} class="btn btn-gradient w-full">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          viewBox="0 0 20 20"
          fill="currentColor"
        >
          <path
            fill-rule="evenodd"
            d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z"
            clip-rule="evenodd"
          />
        </svg>
        <span>{gettext("Create an event")}</span>
      </.link>
    </div>
  </div>
</div>

<!-- Drawer Overlay -->
<div
  id="drawer-overlay"
  class={"fixed inset-0 bg-black/50 z-40 transition-opacity duration-300 #{if @live_action in [:new, :edit], do: "opacity-100", else: "opacity-0 pointer-events-none"}"}
  phx-click={JS.patch(folder_href(@path))}
/>

<!-- Sliding Drawer Panel -->
<div
  id="drawer-panel"
  role={if @live_action in [:new, :edit], do: "dialog"}
  aria-modal={if @live_action in [:new, :edit], do: "true"}
  aria-labelledby={if @live_action in [:new, :edit], do: "event-editor-title"}
  aria-hidden={@live_action not in [:new, :edit]}
  class={"fixed top-0 right-0 h-full w-full sm:w-[520px] bg-base-100 shadow-xl z-50 transform transition-transform duration-300 ease-in-out overflow-hidden #{if @live_action in [:new, :edit], do: "translate-x-0", else: "translate-x-full"}"}
  phx-window-keydown={if @live_action in [:new, :edit], do: JS.patch(folder_href(@path))}
  phx-key="Escape"
>
  <%= if @live_action in [:new, :edit] do %>
    <div class="flex flex-col h-full">
      <.live_component
        module={ClaperWeb.EventLive.EventFormComponent}
        id="event-create"
        event={@event}
        page_title={@page_title}
        action={@live_action}
        return_to={folder_href(@path)}
        current_user={@current_user}
        container={:drawer}
      />
    </div>
  <% end %>
</div>

<!-- Folder editor -->
<div
  :if={@editing_folder}
  id="folder-drawer-overlay"
  class="fixed inset-0 bg-black/50 z-40"
  phx-click="close-folder-editor"
/>
<div
  :if={@editing_folder}
  id="folder-drawer-panel"
  role="dialog"
  aria-modal="true"
  aria-labelledby="folder-editor-title"
  class="fixed top-0 right-0 h-full w-full sm:w-[520px] bg-base-100 shadow-xl z-50 overflow-hidden"
  phx-window-keydown="close-folder-editor"
  phx-key="Escape"
>
  <div class="flex h-full flex-col">
    <header class="flex shrink-0 items-center gap-3 border-b border-base-300 bg-base-100 px-4 py-4 sm:px-6">
      <button
        type="button"
        phx-click="close-folder-editor"
        aria-label={gettext("Close folder editor")}
        class="btn btn-ghost btn-circle !size-10 shrink-0"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          class="h-5 w-5"
          aria-hidden="true"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
      <h1 id="folder-editor-title" class="truncate text-xl font-bold text-secondary">
        {gettext("Edit folder")}
      </h1>
    </header>

    <div class="flex-1 space-y-7 overflow-y-auto px-4 py-6 sm:px-6">
      <form id="folder-form" phx-submit="save-folder" class="space-y-4">
        <div class="flex flex-col gap-1">
          <label for="folder-name" class="text-sm font-bold text-base-content">
            {gettext("Folder name")}
          </label>
          <input
            id="folder-name"
            type="text"
            name="name"
            maxlength="50"
            required
            value={@editing_folder.name}
            class="input input-bordered w-full bg-white h-12"
          />
        </div>

        <div class="flex flex-col gap-1">
          <label for="folder-parent" class="text-sm font-bold text-base-content">
            {gettext("Parent folder")}
          </label>
          <select
            id="folder-parent"
            name="parent_id"
            class="select select-bordered w-full bg-white h-12"
          >
            <option value="" selected={is_nil(@editing_folder.parent_id)}>
              {gettext("Top level")}
            </option>
            <option
              :for={{label, id} <- @folder_edit_options}
              value={id}
              selected={id == @editing_folder.parent_id}
            >
              {label}
            </option>
          </select>
        </div>

        <button type="submit" class="btn btn-primary w-full">{gettext("Save changes")}</button>
      </form>

      <form
        id="delete-folder-form"
        phx-submit="delete-folder"
        class="space-y-3 border-t border-base-300 pt-7"
      >
        <div>
          <h2 class="text-base font-bold text-error">{gettext("Delete folder")}</h2>
          <p class="mt-1 text-xs leading-5 text-base-content/60">
            {gettext(
              "The events inside the folder are kept and end up without a folder. Subfolders move up one level."
            )}
          </p>
        </div>

        <label class="flex cursor-pointer items-center gap-3">
          <input
            type="checkbox"
            name="delete_events"
            value="true"
            class="checkbox checkbox-error"
          />
          <span class="text-sm">{gettext("Delete Events inside the Folder")}</span>
        </label>

        <button
          type="submit"
          data-confirm={
            gettext(
              "Delete this folder? If \"Delete Events inside the Folder\" is checked, those events are permanently deleted."
            )
          }
          class="btn btn-outline btn-error w-full"
        >
          {gettext("Delete folder")}
        </button>
      </form>
    </div>
  </div>
</div>
