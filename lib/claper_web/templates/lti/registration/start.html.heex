<!DOCTYPE html>
<html lang={Gettext.get_locale(ClaperWeb.Gettext)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{gettext("Register your platform")}</title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
  </head>
  <body class="bg-gray-900 text-white">
    <main class="min-h-screen flex flex-col items-center justify-center gap-6 p-8 text-center">
      <img src={~p"/images/logo-white.svg"} class="h-16 w-auto" alt="Claper" />
      <h1 class="text-3xl font-bold">{gettext("Bring Claper to your LMS")}</h1>
      <p class="max-w-xl">
        {gettext(
          "Continue in a new tab to sign in and securely confirm platform registration. Return to your LMS when registration is complete."
        )}
      </p>
      <a
        id="open-lti-registration"
        href={
          ~p"/lti/register/continue?#{%{openid_configuration: @conf, registration_token: @token}}"
        }
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary"
      >
        {gettext("Continue registration in Claper")}
      </a>
    </main>
  </body>
</html>
