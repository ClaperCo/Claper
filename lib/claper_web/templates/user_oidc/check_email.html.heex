<div>
  <div class="relative min-h-screen bg-black">
    <div class="flex justify-center md:items-center h-screen w-full p-8 md:p-10 lg:p-14">
      <div class="max-w-xl w-full space-y-4 mx-auto text-center">
        <img src="/images/icons/email.png" class="w-auto inline mt-6" alt="" />
        <p id="oidc-check-email" class="mt-6 text-lg md:text-xl font-bold text-gray-100">
          {gettext("Check your email to finish signing in with %{provider}.",
            provider: @provider_name
          )}
        </p>
        <p class="text-gray-300">
          {gettext(
            "We sent a confirmation link to the email address of your account. Open it in this browser within 15 minutes."
          )}
        </p>
        <div class="mt-10">
          <.link href={~p"/"} class="text-sm text-white underline">
            {gettext("back to the home page")}
          </.link>
        </div>
      </div>
    </div>
  </div>
</div>
