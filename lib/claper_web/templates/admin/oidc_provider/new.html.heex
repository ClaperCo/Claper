<div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between">
  <h2 class="text-lg font-medium text-gray-900">Add New OIDC Provider</h2>
  <div class="mt-4 md:mt-0">
    <a href={Routes.admin_oidc_provider_path(@conn, :index)} class="inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
      <i class="fas fa-arrow-left mr-2"></i> Back to List
    </a>
  </div>
</div>

<div class="bg-white shadow overflow-hidden sm:rounded-lg">
  <div class="px-4 py-5 sm:px-6">
    <h3 class="text-lg leading-6 font-medium text-gray-900">Provider Information</h3>
    <p class="mt-1 max-w-2xl text-sm text-gray-500">Configure a new OIDC provider for authentication.</p>
  </div>
  
  <%= form_for @changeset, Routes.admin_oidc_provider_path(@conn, :create), fn f -> %>
    <div class="border-t border-gray-200 px-4 py-5 sm:p-6">
      <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
        <div class="sm:col-span-3">
          <%= render ClaperWeb.Admin.SharedView, "_form_field.html",
            form: f,
            field: :name,
            type: :text,
            label: "Provider Name",
            required: true,
            placeholder: "Google, Microsoft, Okta...",
            description: "Display name for this provider."
          %>
        </div>

        <div class="sm:col-span-3">
          <%= render ClaperWeb.Admin.SharedView, "_form_field.html",
            form: f,
            field: :active,
            type: :checkbox,
            label: "Active Status",
            description: "When enabled, users can authenticate with this provider."
          %>
        </div>

        <div class="sm:col-span-6">
          <%= render ClaperWeb.Admin.SharedView, "_form_field.html",
            form: f,
            field: :issuer,
            type: :text,
            label: "Issuer URL",
            required: true,
            placeholder: "https://accounts.google.com",
            description: "The base URL of the OIDC provider (e.g., https://accounts.google.com)."
          %>
        </div>

        <div class="sm:col-span-3">
          <%= render ClaperWeb.Admin.SharedView, "_form_field.html",
            form: f,
            field: :client_id,
            type: :text,
            label: "Client ID",
            required: true,
            description: "Client identifier issued by the OIDC provider."
          %>
        </div>

        <div class="sm:col-span-3">
          <div class="relative">
            <%= render ClaperWeb.Admin.SharedView, "_form_field.html",
              form: f,
              field: :client_secret,
              type: :password,
              label: "Client Secret",
              required: true,
              description: "Client secret issued by the OIDC provider."
            %>
            <div class="mt-1">
              <div class="flex items-center">
                <input type="checkbox" id="show-secret" class="h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded">
                <label for="show-secret" class="ml-2 text-sm text-gray-600">Show client secret</label>
              </div>
            </div>
          </div>
        </div>

        <div class="sm:col-span-3">
          <%= render ClaperWeb.Admin.SharedView, "_form_field.html",
            form: f,
            field: :scope,
            type: :text,
            label: "Scope",
            placeholder: "openid email profile",
            description: "Space-separated list of scopes (leave empty for default)."
          %>
        </div>

        <div class="sm:col-span-3">
          <%= render ClaperWeb.Admin.SharedView, "_form_field.html",
            form: f,
            field: :response_type,
            type: :select,
            options: [code: "code", token: "token", id_token: "id_token", "code token": "code token", "code id_token": "code id_token", "token id_token": "token id_token", "code token id_token": "code token id_token"],
            label: "Response Type",
            description: "The type of response expected from the authorization endpoint."
          %>
        </div>

        <div class="sm:col-span-6">
          <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4">
            <div class="flex">
              <div class="flex-shrink-0">
                <i class="fas fa-exclamation-triangle text-yellow-400"></i>
              </div>
              <div class="ml-3">
                <p class="text-sm text-yellow-700">
                  After creating this provider, you'll need to configure the redirect URI in your OIDC provider's settings.
                  The redirect URI will be displayed after you create the provider.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="px-4 py-3 bg-gray-50 text-right sm:px-6">
      <button type="submit" class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
        <i class="fas fa-plus mr-2"></i> Create Provider
      </button>
    </div>
  <% end %>
</div>

<!-- Common OIDC Providers Reference -->
<div class="mt-6">
  <div class="bg-white shadow overflow-hidden sm:rounded-lg">
    <div class="px-4 py-5 sm:px-6">
      <h3 class="text-lg leading-6 font-medium text-gray-900">Common OIDC Providers</h3>
      <p class="mt-1 max-w-2xl text-sm text-gray-500">Reference information for popular OIDC providers.</p>
    </div>
    <div class="border-t border-gray-200">
      <dl>
        <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Google</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
            <p>Issuer: https://accounts.google.com</p>
            <p class="mt-1">
              <a href="https://console.developers.google.com/" target="_blank" class="text-indigo-600 hover:text-indigo-900">
                Google Developer Console <i class="fas fa-external-link-alt ml-1"></i>
              </a>
            </p>
          </dd>
        </div>
        <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Microsoft</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
            <p>Issuer: https://login.microsoftonline.com/{tenant-id}/v2.0</p>
            <p class="mt-1">
              <a href="https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps/ApplicationsListBlade" target="_blank" class="text-indigo-600 hover:text-indigo-900">
                Azure Portal <i class="fas fa-external-link-alt ml-1"></i>
              </a>
            </p>
          </dd>
        </div>
        <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
          <dt class="text-sm font-medium text-gray-500">Okta</dt>
          <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
            <p>Issuer: https://{your-domain}.okta.com</p>
            <p class="mt-1">
              <a href="https://developer.okta.com/docs/guides/implement-auth-code-pkce/overview/" target="_blank" class="text-indigo-600 hover:text-indigo-900">
                Okta Developer Documentation <i class="fas fa-external-link-alt ml-1"></i>
              </a>
            </p>
          </dd>
        </div>
      </dl>
    </div>
  </div>
</div>

<!-- JavaScript for toggling client secret visibility -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const showSecretCheckbox = document.getElementById('show-secret');
    const clientSecretInput = document.querySelector('input[name="oidc_provider[client_secret]"]');
    
    if (showSecretCheckbox && clientSecretInput) {
      showSecretCheckbox.addEventListener('change', function() {
        if (this.checked) {
          clientSecretInput.type = 'text';
        } else {
          clientSecretInput.type = 'password';
        }
      });
    }
  });
</script>
