<div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between">
  <h2 class="text-lg font-medium text-gray-900">OIDC Provider Details</h2>
  <div class="mt-4 md:mt-0 flex space-x-3">
    <a href={~p"/admin/oidc_providers/#{@provider}/edit"} class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
      <i class="fas fa-edit mr-2"></i> Edit Provider
    </a>
    <a href={~p"/admin/oidc_providers"} class="inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
      <i class="fas fa-arrow-left mr-2"></i> Back to List
    </a>
  </div>
</div>

<div class="bg-white shadow overflow-hidden sm:rounded-lg">
  <div class="px-4 py-5 sm:px-6">
    <h3 class="text-lg leading-6 font-medium text-gray-900"><%= @provider.name %></h3>
    <p class="mt-1 max-w-2xl text-sm text-gray-500">OIDC provider details and configuration.</p>
  </div>
  <div class="border-t border-gray-200">
    <dl>
      <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
        <dt class="text-sm font-medium text-gray-500">Name</dt>
        <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= @provider.name %></dd>
      </div>
      <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
        <dt class="text-sm font-medium text-gray-500">Issuer</dt>
        <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= @provider.issuer %></dd>
      </div>
      <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
        <dt class="text-sm font-medium text-gray-500">Client ID</dt>
        <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= @provider.client_id %></dd>
      </div>
      <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
        <dt class="text-sm font-medium text-gray-500">Client Secret</dt>
        <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
          <div class="flex items-center">
            <span class="text-gray-500">••••••••••••••••</span>
            <button type="button" id="toggle-secret" class="ml-2 text-indigo-600 hover:text-indigo-900 focus:outline-none">
              <i class="fas fa-eye"></i>
            </button>
            <span id="client-secret" class="hidden ml-2"><%= @provider.client_secret %></span>
          </div>
        </dd>
      </div>
      <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
        <dt class="text-sm font-medium text-gray-500">Discovery Document URL</dt>
        <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
          <a href={"#{@provider.issuer}/.well-known/openid-configuration"} target="_blank" class="text-indigo-600 hover:text-indigo-900">
            <%= @provider.issuer %>/.well-known/openid-configuration
            <i class="fas fa-external-link-alt ml-1"></i>
          </a>
        </dd>
      </div>
      <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
        <dt class="text-sm font-medium text-gray-500">Status</dt>
        <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
          <%= if @provider.active do %>
            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">Active</span>
          <% else %>
            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">Inactive</span>
          <% end %>
        </dd>
      </div>
      <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
        <dt class="text-sm font-medium text-gray-500">Scope</dt>
        <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
          <%= if @provider.scope do %>
            <%= @provider.scope %>
          <% else %>
            <span class="text-gray-400">Default (openid email profile)</span>
          <% end %>
        </dd>
      </div>
      <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
        <dt class="text-sm font-medium text-gray-500">Response Type</dt>
        <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
          <%= if @provider.response_type do %>
            <%= @provider.response_type %>
          <% else %>
            <span class="text-gray-400">Default (code)</span>
          <% end %>
        </dd>
      </div>
      <div class="bg-gray-50 px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
        <dt class="text-sm font-medium text-gray-500">Created At</dt>
        <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= NaiveDateTime.to_string(@provider.inserted_at) %></dd>
      </div>
      <div class="bg-white px-4 py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
        <dt class="text-sm font-medium text-gray-500">Last Updated</dt>
        <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2"><%= NaiveDateTime.to_string(@provider.updated_at) %></dd>
      </div>
    </dl>
  </div>
</div>

<div class="mt-6 flex justify-between">
  <div>
    <a href={~p"/admin/oidc_providers/#{@provider}/test_connection"} class="inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
      <i class="fas fa-plug mr-2"></i> Test Connection
    </a>
  </div>
  
  <%= link "Delete Provider", to: ~p"/admin/oidc_providers/#{@provider}", method: :delete, data: [confirm: "Are you sure you want to delete this OIDC provider? This action cannot be undone."], class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" %>
</div>

<!-- JavaScript for toggling client secret visibility -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const toggleButton = document.getElementById('toggle-secret');
    const clientSecret = document.getElementById('client-secret');
    
    if (toggleButton && clientSecret) {
      toggleButton.addEventListener('click', function() {
        const icon = toggleButton.querySelector('i');
        
        if (clientSecret.classList.contains('hidden')) {
          clientSecret.classList.remove('hidden');
          icon.classList.remove('fa-eye');
          icon.classList.add('fa-eye-slash');
        } else {
          clientSecret.classList.add('hidden');
          icon.classList.remove('fa-eye-slash');
          icon.classList.add('fa-eye');
        }
      });
    }
  });
</script>
