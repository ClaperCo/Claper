<div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between">
  <h2 class="text-lg font-medium text-gray-900">Edit OIDC Provider</h2>
  <div class="mt-4 md:mt-0">
    <a href={Routes.admin_oidc_provider_path(@conn, :index)} class="inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
      <i class="fas fa-arrow-left mr-2"></i> Back to List
    </a>
  </div>
</div>

<div class="bg-white shadow overflow-hidden sm:rounded-lg">
  <div class="px-4 py-5 sm:px-6">
    <h3 class="text-lg leading-6 font-medium text-gray-900">Provider Information</h3>
    <p class="mt-1 max-w-2xl text-sm text-gray-500">Edit OIDC provider details.</p>
  </div>
  
  <%= form_for @changeset, Routes.admin_oidc_provider_path(@conn, :update, @provider), fn f -> %>
    <div class="border-t border-gray-200 px-4 py-5 sm:p-6">
      <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
        <div class="sm:col-span-3">
          <%= render ClaperWeb.Admin.SharedView, "_form_field.html",
            form: f,
            field: :name,
            type: :text,
            label: "Provider Name",
            required: true,
            description: "Display name for this provider."
          %>
        </div>

        <div class="sm:col-span-3">
          <%= render ClaperWeb.Admin.SharedView, "_form_field.html",
            form: f,
            field: :active,
            type: :checkbox,
            label: "Active Status",
            description: "When enabled, users can authenticate with this provider."
          %>
        </div>

        <div class="sm:col-span-6">
          <%= render ClaperWeb.Admin.SharedView, "_form_field.html",
            form: f,
            field: :issuer,
            type: :text,
            label: "Issuer URL",
            required: true,
            description: "The base URL of the OIDC provider (e.g., https://accounts.google.com)."
          %>
        </div>

        <div class="sm:col-span-3">
          <%= render ClaperWeb.Admin.SharedView, "_form_field.html",
            form: f,
            field: :client_id,
            type: :text,
            label: "Client ID",
            required: true,
            description: "Client identifier issued by the OIDC provider."
          %>
        </div>

        <div class="sm:col-span-3">
          <div class="relative">
            <%= render ClaperWeb.Admin.SharedView, "_form_field.html",
              form: f,
              field: :client_secret,
              type: :password,
              label: "Client Secret",
              required: true,
              value: @provider.client_secret,
              description: "Client secret issued by the OIDC provider."
            %>
            <div class="mt-1">
              <div class="flex items-center">
                <input type="checkbox" id="show-secret" class="h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded">
                <label for="show-secret" class="ml-2 text-sm text-gray-600">Show client secret</label>
              </div>
            </div>
          </div>
        </div>

        <div class="sm:col-span-3">
          <%= render ClaperWeb.Admin.SharedView, "_form_field.html",
            form: f,
            field: :scope,
            type: :text,
            label: "Scope",
            placeholder: "openid email profile",
            description: "Space-separated list of scopes (leave empty for default)."
          %>
        </div>

        <div class="sm:col-span-3">
          <%= render ClaperWeb.Admin.SharedView, "_form_field.html",
            form: f,
            field: :response_type,
            type: :select,
            options: [code: "code", token: "token", id_token: "id_token", "code token": "code token", "code id_token": "code id_token", "token id_token": "token id_token", "code token id_token": "code token id_token"],
            label: "Response Type",
            description: "The type of response expected from the authorization endpoint."
          %>
        </div>

        <div class="sm:col-span-6">
          <%= render ClaperWeb.Admin.SharedView, "_form_field.html",
            form: f,
            field: :redirect_uri,
            type: :text,
            label: "Redirect URI",
            disabled: true,
            value: @redirect_uri,
            description: "Use this URI in your OIDC provider configuration."
          %>
        </div>
      </div>
    </div>
    
    <div class="px-4 py-3 bg-gray-50 text-right sm:px-6">
      <button type="submit" class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
        <i class="fas fa-save mr-2"></i> Save Changes
      </button>
    </div>
  <% end %>
</div>

<div class="mt-6">
  <div class="bg-white shadow overflow-hidden sm:rounded-lg">
    <div class="px-4 py-5 sm:px-6">
      <h3 class="text-lg leading-6 font-medium text-gray-900">Danger Zone</h3>
      <p class="mt-1 max-w-2xl text-sm text-gray-500">Destructive actions for this provider.</p>
    </div>
    <div class="border-t border-gray-200 px-4 py-5 sm:p-6">
      <div class="space-y-6">
        <div>
          <h3 class="text-sm font-medium text-gray-900">Delete Provider</h3>
          <div class="mt-2 max-w-xl text-sm text-gray-500">
            <p>Once you delete this provider, there is no going back. Please be certain.</p>
          </div>
          <div class="mt-3">
            <%= link "Delete Provider", to: Routes.admin_oidc_provider_path(@conn, :delete, @provider), method: :delete, data: [confirm: "Are you sure you want to delete this OIDC provider? This action cannot be undone."], class: "inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- JavaScript for toggling client secret visibility -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const showSecretCheckbox = document.getElementById('show-secret');
    const clientSecretInput = document.querySelector('input[name="oidc_provider[client_secret]"]');
    
    if (showSecretCheckbox && clientSecretInput) {
      showSecretCheckbox.addEventListener('change', function() {
        if (this.checked) {
          clientSecretInput.type = 'text';
        } else {
          clientSecretInput.type = 'password';
        }
      });
    }
  });
</script>
