<div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between">
  <h2 class="text-lg font-medium text-gray-900">OIDC Providers List</h2>
</div>

<%= render ClaperWeb.Admin.SharedView, "_search_filter.html", 
  search_path: Routes.admin_oidc_provider_path(@conn, :index),
  search_placeholder: "Search by name, issuer...",
  search_value: @search,
  filters: [],
  clear_path: Routes.admin_oidc_provider_path(@conn, :index),
  new_path: Routes.admin_oidc_provider_path(@conn, :new),
  new_label: "Add Provider",
  export_csv_path: Routes.admin_oidc_provider_path(@conn, :index, Map.put(@conn.params, "format", "csv")),
  conn: @conn
%>

<%= render ClaperWeb.Admin.SharedView, "_table.html", 
  conn: @conn,
  items: @providers,
  columns: [
    %{label: "Name", field: :name},
    %{label: "Issuer", field: :issuer},
    %{label: "Client ID", field: :client_id, value_fn: fn provider -> 
      if String.length(provider.client_id) > 15 do
        String.slice(provider.client_id, 0, 15) <> "..."
      else
        provider.client_id
      end
    end},
    %{label: "Active", field: :active, value_fn: fn provider -> 
      if provider.active do
        {:icon, "check-circle", "green", "Yes"}
      else
        {:icon, "times-circle", "red", "No"}
      end
    end},
    %{label: "Created", field: :inserted_at, value_fn: fn provider -> 
      NaiveDateTime.to_date(provider.inserted_at)
    end}
  ],
  actions: fn provider -> [
    %{label: "View", icon: "eye", path: Routes.admin_oidc_provider_path(@conn, :show, provider), color: "indigo"},
    %{label: "Edit", icon: "edit", path: Routes.admin_oidc_provider_path(@conn, :edit, provider), color: "indigo"},
    %{label: "Test Connection", icon: "plug", path: Routes.admin_oidc_provider_path(@conn, :test_connection, provider), color: "indigo"},
    %{label: "Delete", icon: "trash", path: "#", color: "red", modal_id: "delete-provider-#{provider.id}"}
  ] end,
  empty_message: "No OIDC providers found"
%>

<%= for provider <- @providers do %>
  <%= render ClaperWeb.Admin.SharedView, "_modal.html", 
    id: "delete-provider-#{provider.id}",
    title: "Delete OIDC Provider",
    content: "Are you sure you want to delete the OIDC provider '#{provider.name}'? This action cannot be undone.",
    confirm_action: "Delete",
    confirm_path: Routes.admin_oidc_provider_path(@conn, :delete, provider),
    confirm_method: :delete,
    confirm_class: "bg-red-600 hover:bg-red-700",
    cancel_action: "Cancel",
    icon: "fa-exclamation-triangle",
    conn: @conn
  %>
<% end %>

<!-- Pagination -->
<%= if @total_pages > 1 do %>
  <div class="mt-6 flex items-center justify-between">
    <div class="text-sm text-gray-700">
      Showing <span class="font-medium"><%= (@page_number - 1) * @page_size + 1 %></span> to <span class="font-medium"><%= min(@page_number * @page_size, @total_entries) %></span> of <span class="font-medium"><%= @total_entries %></span> results
    </div>
    <div class="flex-1 flex justify-between sm:justify-end">
      <%= if @page_number > 1 do %>
        <a href={Routes.admin_oidc_provider_path(@conn, :index, page: @page_number - 1, search: @search)} class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
          Previous
        </a>
      <% end %>
      <%= if @page_number < @total_pages do %>
        <a href={Routes.admin_oidc_provider_path(@conn, :index, page: @page_number + 1, search: @search)} class="ml-3 relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
          Next
        </a>
      <% end %>
    </div>
  </div>
<% end %>
