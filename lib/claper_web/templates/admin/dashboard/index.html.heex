<div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
  <!-- Total Users Card -->
  <div class="bg-white overflow-hidden shadow rounded-lg">
    <div class="p-5">
      <div class="flex items-center">
        <div class="flex-shrink-0 bg-indigo-500 rounded-md p-3">
          <i class="fas fa-users text-white text-xl"></i>
        </div>
        <div class="ml-5 w-0 flex-1">
          <dl>
            <dt class="text-sm font-medium text-gray-500 truncate">Total Users</dt>
            <dd>
              <div class="text-lg font-medium text-gray-900"><%= @stats.total_users %></div>
            </dd>
          </dl>
        </div>
      </div>
    </div>
    <div class="bg-gray-50 px-5 py-3">
      <div class="text-sm">
        <a href={Routes.admin_user_path(@conn, :index)} class="font-medium text-indigo-600 hover:text-indigo-500">View all users</a>
      </div>
    </div>
  </div>

  <!-- Total Events Card -->
  <div class="bg-white overflow-hidden shadow rounded-lg">
    <div class="p-5">
      <div class="flex items-center">
        <div class="flex-shrink-0 bg-green-500 rounded-md p-3">
          <i class="fas fa-calendar-alt text-white text-xl"></i>
        </div>
        <div class="ml-5 w-0 flex-1">
          <dl>
            <dt class="text-sm font-medium text-gray-500 truncate">Total Events</dt>
            <dd>
              <div class="text-lg font-medium text-gray-900"><%= @stats.total_events %></div>
            </dd>
          </dl>
        </div>
      </div>
    </div>
    <div class="bg-gray-50 px-5 py-3">
      <div class="text-sm">
        <a href={Routes.admin_event_path(@conn, :index)} class="font-medium text-indigo-600 hover:text-indigo-500">View all events</a>
      </div>
    </div>
  </div>

  <!-- Upcoming Events Card -->
  <div class="bg-white overflow-hidden shadow rounded-lg">
    <div class="p-5">
      <div class="flex items-center">
        <div class="flex-shrink-0 bg-yellow-500 rounded-md p-3">
          <i class="fas fa-clock text-white text-xl"></i>
        </div>
        <div class="ml-5 w-0 flex-1">
          <dl>
            <dt class="text-sm font-medium text-gray-500 truncate">Upcoming Events</dt>
            <dd>
              <div class="text-lg font-medium text-gray-900"><%= @stats.upcoming_events %></div>
            </dd>
          </dl>
        </div>
      </div>
    </div>
    <div class="bg-gray-50 px-5 py-3">
      <div class="text-sm">
        <a href={Routes.admin_event_path(@conn, :index, status: "upcoming")} class="font-medium text-indigo-600 hover:text-indigo-500">View upcoming events</a>
      </div>
    </div>
  </div>
</div>

<!-- Upcoming Events Table -->
<div class="mt-8">
  <h2 class="text-lg font-medium text-gray-900 mb-4">Upcoming Events</h2>
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Code</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Creator</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Scheduled At</th>
          <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <%= if Enum.empty?(@upcoming_events) do %>
          <tr>
            <td colspan="5" class="px-6 py-4 text-center text-sm text-gray-500">No upcoming events found</td>
          </tr>
        <% else %>
          <%= for event <- @upcoming_events do %>
            <tr>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= event.name %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= event.code %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= event.user.email %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                <%= if event.scheduled_at do %>
                  <%= NaiveDateTime.to_string(event.scheduled_at) %>
                <% else %>
                  Not scheduled
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                <a href={Routes.admin_event_path(@conn, :show, event)} class="text-indigo-600 hover:text-indigo-900 mr-3">View</a>
                <a href={Routes.admin_event_path(@conn, :edit, event)} class="text-indigo-600 hover:text-indigo-900">Edit</a>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<!-- Quick Links -->
<div class="mt-8">
  <h2 class="text-lg font-medium text-gray-900 mb-4">Quick Links</h2>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <a href={Routes.admin_user_path(@conn, :new)} class="bg-white overflow-hidden shadow rounded-lg p-4 hover:bg-gray-50">
      <div class="flex items-center">
        <div class="flex-shrink-0 bg-indigo-100 rounded-md p-2">
          <i class="fas fa-user-plus text-indigo-600"></i>
        </div>
        <div class="ml-4">
          <p class="text-sm font-medium text-gray-900">Add New User</p>
        </div>
      </div>
    </a>
    
    <a href={Routes.admin_oidc_provider_path(@conn, :new)} class="bg-white overflow-hidden shadow rounded-lg p-4 hover:bg-gray-50">
      <div class="flex items-center">
        <div class="flex-shrink-0 bg-indigo-100 rounded-md p-2">
          <i class="fas fa-key text-indigo-600"></i>
        </div>
        <div class="ml-4">
          <p class="text-sm font-medium text-gray-900">Add OIDC Provider</p>
        </div>
      </div>
    </a>
    
    <a href={Routes.admin_user_path(@conn, :index, role: "admin")} class="bg-white overflow-hidden shadow rounded-lg p-4 hover:bg-gray-50">
      <div class="flex items-center">
        <div class="flex-shrink-0 bg-indigo-100 rounded-md p-2">
          <i class="fas fa-user-shield text-indigo-600"></i>
        </div>
        <div class="ml-4">
          <p class="text-sm font-medium text-gray-900">View Admins</p>
        </div>
      </div>
    </a>
    
    <a href={Routes.admin_event_path(@conn, :index)} class="bg-white overflow-hidden shadow rounded-lg p-4 hover:bg-gray-50">
      <div class="flex items-center">
        <div class="flex-shrink-0 bg-indigo-100 rounded-md p-2">
          <i class="fas fa-calendar-alt text-indigo-600"></i>
        </div>
        <div class="ml-4">
          <p class="text-sm font-medium text-gray-900">Manage Events</p>
        </div>
      </div>
    </a>
  </div>
</div>
