<%!-- 
  Table actions component for admin panel tables
  Usage:
  <%= render ClaperWeb.Admin.SharedView, "_table_actions.html", 
    view_path: Routes.admin_user_path(@conn, :show, user),
    edit_path: Routes.admin_user_path(@conn, :edit, user),
    delete_path: Routes.admin_user_path(@conn, :delete, user),
    delete_modal_id: "delete-user-#{user.id}",  # Optional
    conn: @conn
  %>
--%>

<div class="flex items-center space-x-2">
  <%= if assigns[:view_path] do %>
    <a href={@view_path} class="text-indigo-600 hover:text-indigo-900" title="View">
      <i class="fas fa-eye"></i>
      <span class="sr-only">View</span>
    </a>
  <% end %>
  
  <%= if assigns[:edit_path] do %>
    <a href={@edit_path} class="text-indigo-600 hover:text-indigo-900" title="Edit">
      <i class="fas fa-edit"></i>
      <span class="sr-only">Edit</span>
    </a>
  <% end %>
  
  <%= if assigns[:delete_path] do %>
    <%= if assigns[:delete_modal_id] do %>
      <button 
        type="button" 
        data-modal-target={@delete_modal_id}
        class="text-red-600 hover:text-red-900" 
        title="Delete">
        <i class="fas fa-trash-alt"></i>
        <span class="sr-only">Delete</span>
      </button>
    <% else %>
      <%= link to: @delete_path, method: :delete, 
          data: [confirm: "Are you sure you want to delete this item? This action cannot be undone."], 
          class: "text-red-600 hover:text-red-900", 
          title: "Delete" do %>
        <i class="fas fa-trash-alt"></i>
        <span class="sr-only">Delete</span>
      <% end %>
    <% end %>
  <% end %>
  
  <%= if assigns[:custom_actions] do %>
    <%= @custom_actions %>
  <% end %>
</div>
