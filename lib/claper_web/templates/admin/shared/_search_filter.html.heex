<%!-- 
  Search and filter component for admin panel tables
  Usage:
  <%= render ClaperWeb.Admin.SharedView, "_search_filter.html", 
    search_path: ~p"/admin/users",
    search_placeholder: "Search users...",
    filters: [
      %{name: "role", label: "Role", options: [{"All", ""}, {"Admin", "admin"}, {"User", "user"}]},
      %{name: "status", label: "Status", options: [{"All", ""}, {"Active", "active"}, {"Inactive", "inactive"}]}
    ],
    export_csv_path: ~p"/admin/users/export_csv",
    conn: @conn
  %>
--%>

<div class="bg-white px-4 py-5 border-b border-gray-200 sm:px-6">
  <div class="-ml-4 -mt-2 flex items-center justify-between flex-wrap sm:flex-nowrap">
    <div class="ml-4 mt-2">
      <form action={@search_path} method="get" class="flex items-center">
        <div class="relative rounded-md shadow-sm">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <i class="fas fa-search text-gray-400"></i>
          </div>
          <input 
            type="text" 
            name="search" 
            value={assigns[:search_value] || ""} 
            class="focus:ring-indigo-500 focus:border-indigo-500 block w-full pl-10 sm:text-sm border-gray-300 rounded-md" 
            placeholder={assigns[:search_placeholder] || "Search..."}>
        </div>
        
        <%= if assigns[:filters] do %>
          <div class="ml-3 flex space-x-2">
            <%= for filter <- @filters do %>
              <select 
                name={filter.name} 
                class="block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm rounded-md"
                onchange="this.form.submit()">
                <option disabled selected><%= filter.label %></option>
                <%= for {label, value} <- filter.options do %>
                  <option value={value} selected={assigns[String.to_atom(filter.name)] == value}><%= label %></option>
                <% end %>
              </select>
            <% end %>
          </div>
        <% end %>
        
        <button type="submit" class="ml-3 inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
          Search
        </button>
        
        <%= if assigns[:clear_path] do %>
          <a href={@clear_path} class="ml-2 inline-flex items-center px-3 py-2 border border-gray-300 shadow-sm text-sm leading-4 font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
            Clear
          </a>
        <% end %>
      </form>
    </div>
    
    <div class="ml-4 mt-2 flex-shrink-0">
      <%= if assigns[:export_csv_path] do %>
        <a href={@export_csv_path} class="relative inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-green-600 hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500">
          <i class="fas fa-file-csv mr-2"></i>
          Export CSV
        </a>
      <% end %>
      
      <%= if assigns[:new_path] do %>
        <a href={@new_path} class="ml-3 relative inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
          <i class="fas fa-plus mr-2"></i>
          <%= assigns[:new_label] || "New" %>
        </a>
      <% end %>
      
      <%= if assigns[:custom_actions] do %>
        <%= @custom_actions %>
      <% end %>
    </div>
  </div>
</div>
