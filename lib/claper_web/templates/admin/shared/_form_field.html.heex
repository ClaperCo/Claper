<%!-- 
  Form field component for admin panel forms
  Usage:
  <%= render ClaperWeb.Admin.SharedView, "_form_field.html", 
    form: f,
    field: :name,
    label: "Full Name",
    type: "text",
    required: true,
    placeholder: "Enter full name",
    description: "User's full name as it will appear in the system",
    options: [class: "custom-class"],  # Optional additional options
    conn: @conn
  %>
--%>

<div class={if assigns[:width_class], do: @width_class, else: "sm:col-span-6"}>
  <%= label @form, @field, @label, class: "block text-sm font-medium text-gray-700" %>
  <div class="mt-1">
    <%= case @type do %>
      <% "text" -> %>
        <%= text_input @form, @field, 
          [class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md", 
           placeholder: assigns[:placeholder] || "", 
           required: assigns[:required] || false] ++ (assigns[:options] || []) %>
      
      <% "email" -> %>
        <%= email_input @form, @field, 
          [class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md", 
           placeholder: assigns[:placeholder] || "", 
           required: assigns[:required] || false] ++ (assigns[:options] || []) %>
      
      <% "password" -> %>
        <div class="relative">
          <%= password_input @form, @field, 
            [class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md", 
             placeholder: assigns[:placeholder] || "", 
             required: assigns[:required] || false,
             id: "password-field-#{@field}"] ++ (assigns[:options] || []) %>
          <button type="button" class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-600 toggle-password" data-target="password-field-#{@field}">
            <i class="fas fa-eye"></i>
          </button>
        </div>
      
      <% "textarea" -> %>
        <%= textarea @form, @field, 
          [class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md", 
           placeholder: assigns[:placeholder] || "", 
           required: assigns[:required] || false,
           rows: assigns[:rows] || 3] ++ (assigns[:options] || []) %>
      
      <% "select" -> %>
        <%= select @form, @field, assigns[:select_options], 
          [class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md", 
           prompt: assigns[:prompt] || "Select an option", 
           required: assigns[:required] || false] ++ (assigns[:options] || []) %>
      
      <% "checkbox" -> %>
        <div class="flex items-center">
          <%= checkbox @form, @field, 
            [class: "h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded"] ++ (assigns[:options] || []) %>
          <span class="ml-2 text-sm text-gray-600"><%= assigns[:checkbox_label] || @label %></span>
        </div>
      
      <% "date" -> %>
        <%= date_input @form, @field, 
          [class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md", 
           required: assigns[:required] || false] ++ (assigns[:options] || []) %>
      
      <% "datetime" -> %>
        <%= datetime_select @form, @field, 
          [class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm border-gray-300 rounded-md", 
           required: assigns[:required] || false] ++ (assigns[:options] || []) %>
      
      <% "file" -> %>
        <div class="flex items-center">
          <label class="cursor-pointer bg-white py-2 px-3 border border-gray-300 rounded-md shadow-sm text-sm leading-4 font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
            <span>Choose file</span>
            <%= file_input @form, @field, 
              [class: "sr-only", 
               required: assigns[:required] || false] ++ (assigns[:options] || []) %>
          </label>
          <span class="ml-3 text-sm text-gray-500 file-name" data-target="#{@form.id}_#{@field}">No file chosen</span>
        </div>
      
      <% _ -> %>
        <%= text_input @form, @field, 
          [class: "shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md", 
           placeholder: assigns[:placeholder] || "", 
           required: assigns[:required] || false] ++ (assigns[:options] || []) %>
    <% end %>
    
    <%= error_tag @form, @field %>
    
    <%= if assigns[:description] do %>
      <p class="mt-2 text-sm text-gray-500"><%= @description %></p>
    <% end %>
  </div>
</div>

<%= if @type == "password" || @type == "file" do %>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      <%= if @type == "password" do %>
        // Toggle password visibility
        const toggleBtn = document.querySelector('.toggle-password[data-target="password-field-<%= @field %>"]');
        if (toggleBtn) {
          toggleBtn.addEventListener('click', function() {
            const passwordField = document.getElementById('password-field-<%= @field %>');
            const type = passwordField.getAttribute('type') === 'password' ? 'text' : 'password';
            passwordField.setAttribute('type', type);
            
            // Toggle icon
            const icon = toggleBtn.querySelector('i');
            if (type === 'password') {
              icon.classList.remove('fa-eye-slash');
              icon.classList.add('fa-eye');
            } else {
              icon.classList.remove('fa-eye');
              icon.classList.add('fa-eye-slash');
            }
          });
        }
      <% end %>
      
      <%= if @type == "file" do %>
        // Display file name when selected
        const fileInput = document.querySelector('#<%= @form.id %>_<%= @field %>');
        const fileNameSpan = document.querySelector('.file-name[data-target="<%= @form.id %>_<%= @field %>"]');
        
        if (fileInput && fileNameSpan) {
          fileInput.addEventListener('change', function() {
            if (fileInput.files.length > 0) {
              fileNameSpan.textContent = fileInput.files[0].name;
            } else {
              fileNameSpan.textContent = 'No file chosen';
            }
          });
        }
      <% end %>
    });
  </script>
<% end %>
