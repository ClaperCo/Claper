<%!-- 
  Modal component for admin panel
  Usage:
  <%= render ClaperWeb.Admin.SharedView, "_modal.html", 
    id: "delete-confirmation",
    title: "Confirm Deletion",
    content: "Are you sure you want to delete this item? This action cannot be undone.",
    confirm_action: "Delete",
    confirm_class: "bg-red-600 hover:bg-red-700",
    cancel_action: "Cancel",
    conn: @conn
  %>
--%>

<div id={"#{@id}-container"} class="hidden fixed z-50 inset-0 overflow-y-auto" aria-labelledby={"#{@id}-title"} role="dialog" aria-modal="true">
  <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
    <!-- Background overlay -->
    <div id={"#{@id}-backdrop"} class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true"></div>
    
    <!-- Trick browser into centering modal contents -->
    <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
    
    <!-- Modal panel -->
    <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
      <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
        <div class="sm:flex sm:items-start">
          <%= if assigns[:icon] do %>
            <div class="mx-auto flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-red-100 sm:mx-0 sm:h-10 sm:w-10">
              <i class={"fas #{@icon} text-red-600"}></i>
            </div>
          <% end %>
          
          <div class={["mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left", (if assigns[:icon], do: "", else: "w-full")]}>
            <h3 class="text-lg leading-6 font-medium text-gray-900" id={"#{@id}-title"}>
              <%= @title %>
            </h3>
            <div class="mt-2">
              <p class="text-sm text-gray-500">
                <%= @content %>
              </p>
              
              <%= if assigns[:form_content] do %>
                <div class="mt-4">
                  <%= @form_content %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
      
      <div class="bg-gray-50 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
        <%= if assigns[:confirm_path] do %>
          <%= link @confirm_action, to: @confirm_path, 
              method: assigns[:confirm_method] || :post,
              class: "w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 text-base font-medium text-white #{@confirm_class} focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 sm:ml-3 sm:w-auto sm:text-sm" %>
        <% else %>
          <button type="button" id={"#{@id}-confirm"} class={["w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 text-base font-medium text-white", @confirm_class, "focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 sm:ml-3 sm:w-auto sm:text-sm"]}>
            <%= @confirm_action %>
          </button>
        <% end %>
        
        <button type="button" id={"#{@id}-cancel"} class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm">
          <%= @cancel_action || "Cancel" %>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const modalId = '<%= @id %>';
    const modalContainer = document.getElementById(`${modalId}-container`);
    const modalBackdrop = document.getElementById(`${modalId}-backdrop`);
    const modalCancelBtn = document.getElementById(`${modalId}-cancel`);
    const modalConfirmBtn = document.getElementById(`${modalId}-confirm`);
    const modalTriggers = document.querySelectorAll(`[data-modal-target="${modalId}"]`);
    
    function openModal() {
      modalContainer.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      
      // Animation
      modalBackdrop.style.opacity = '0';
      modalContainer.querySelector('.transform').style.opacity = '0';
      modalContainer.querySelector('.transform').style.transform = 'scale(0.95)';
      
      setTimeout(() => {
        modalBackdrop.style.opacity = '1';
        modalContainer.querySelector('.transform').style.opacity = '1';
        modalContainer.querySelector('.transform').style.transform = 'scale(1)';
      }, 10);
    }
    
    function closeModal() {
      // Animation
      modalBackdrop.style.opacity = '0';
      modalContainer.querySelector('.transform').style.opacity = '0';
      modalContainer.querySelector('.transform').style.transform = 'scale(0.95)';
      
      setTimeout(() => {
        modalContainer.classList.add('hidden');
        document.body.style.overflow = '';
      }, 200);
    }
    
    // Add click event to all trigger elements
    modalTriggers.forEach(trigger => {
      trigger.addEventListener('click', function(e) {
        e.preventDefault();
        openModal();
      });
    });
    
    // Close modal when clicking cancel button
    if (modalCancelBtn) {
      modalCancelBtn.addEventListener('click', closeModal);
    }
    
    // Close modal when clicking outside
    modalContainer.addEventListener('click', function(e) {
      if (e.target === modalContainer) {
        closeModal();
      }
    });
    
    // Close modal when pressing ESC key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && !modalContainer.classList.contains('hidden')) {
        closeModal();
      }
    });
  });
</script>
