<div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between">
  <h2 class="text-lg font-medium text-gray-900">New User</h2>
  <div class="mt-4 md:mt-0">
    <a href={~p"/admin/users"} class="inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
      <i class="fas fa-arrow-left mr-2"></i> Back to List
    </a>
  </div>
</div>

<div class="bg-white shadow overflow-hidden sm:rounded-lg">
  <div class="px-4 py-5 sm:px-6">
    <h3 class="text-lg leading-6 font-medium text-gray-900">User Information</h3>
    <p class="mt-1 max-w-2xl text-sm text-gray-500">Create a new user account.</p>
  </div>
  
  <%= form_for @changeset, ~p"/admin/users", fn f -> %>
    <div class="border-t border-gray-200 px-4 py-5 sm:p-6">
      <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
        <div class="sm:col-span-3">
          <%= render ClaperWeb.Admin.SharedView, "_form_field.html",
            form: f,
            field: :email,
            type: :email,
            label: "Email",
            required: true,
            description: "The user's email address is used for login and notifications."
          %>
        </div>

        <div class="sm:col-span-3">
          <%= render ClaperWeb.Admin.SharedView, "_form_field.html",
            form: f,
            field: :role_id,
            type: :select,
            label: "Role",
            options: Enum.map(@roles, &{&1.name, &1.id}),
            prompt: "Select role",
            description: "Determines the user's permissions in the system."
          %>
        </div>

        <div class="sm:col-span-3">
          <%= render ClaperWeb.Admin.SharedView, "_form_field.html",
            form: f,
            field: :first_name,
            type: :text,
            label: "First Name"
          %>
        </div>

        <div class="sm:col-span-3">
          <%= render ClaperWeb.Admin.SharedView, "_form_field.html",
            form: f,
            field: :last_name,
            type: :text,
            label: "Last Name"
          %>
        </div>

        <div class="sm:col-span-3">
          <%= render ClaperWeb.Admin.SharedView, "_form_field.html",
            form: f,
            field: :password,
            type: :password,
            label: "Password",
            required: true,
            show_toggle: true,
            description: "Must be at least 8 characters long."
          %>
        </div>

        <div class="sm:col-span-3">
          <%= render ClaperWeb.Admin.SharedView, "_form_field.html",
            form: f,
            field: :password_confirmation,
            type: :password,
            label: "Confirm Password",
            required: true,
            show_toggle: true
          %>
        </div>

        <div class="sm:col-span-3">
          <%= render ClaperWeb.Admin.SharedView, "_form_field.html",
            form: f,
            field: :locale,
            type: :select,
            label: "Preferred Language",
            options: [{"English", "en"}, {"French", "fr"}, {"German", "de"}, {"Spanish", "es"}],
            description: "The user's preferred language for the interface."
          %>
        </div>
      </div>
    </div>
    
    <div class="px-4 py-3 bg-gray-50 text-right sm:px-6">
      <button type="submit" class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
        <i class="fas fa-user-plus mr-2"></i> Create User
      </button>
    </div>
  <% end %>
</div>
