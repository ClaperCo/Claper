<div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between">
  <h2 class="text-lg font-medium text-gray-900">Edit Event</h2>
  <div class="mt-4 md:mt-0">
    <a href={Routes.admin_event_path(@conn, :index)} class="inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
      <i class="fas fa-arrow-left mr-2"></i> Back to List
    </a>
  </div>
</div>

<div class="bg-white shadow overflow-hidden sm:rounded-lg">
  <div class="px-4 py-5 sm:px-6">
    <h3 class="text-lg leading-6 font-medium text-gray-900">Event Information</h3>
    <p class="mt-1 max-w-2xl text-sm text-gray-500">Edit event details.</p>
  </div>
  
  <%= form_for @changeset, Routes.admin_event_path(@conn, :update, @event), fn f -> %>
    <div class="border-t border-gray-200 px-4 py-5 sm:p-6">
      <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
        <div class="sm:col-span-3">
          <%= render ClaperWeb.Admin.SharedView, "_form_field.html",
            form: f,
            field: :name,
            type: :text,
            label: "Event Name",
            required: true,
            description: "The name of the event as it will appear to attendees."
          %>
        </div>

        <div class="sm:col-span-3">
          <%= render ClaperWeb.Admin.SharedView, "_form_field.html",
            form: f,
            field: :code,
            type: :text,
            label: "Event Code",
            required: true,
            description: "A unique code for the event that attendees will use to join."
          %>
        </div>

        <div class="sm:col-span-3">
          <%= render ClaperWeb.Admin.SharedView, "_form_field.html",
            form: f,
            field: :scheduled_at,
            type: :datetime,
            label: "Scheduled Date & Time",
            description: "When the event is scheduled to take place."
          %>
        </div>

        <div class="sm:col-span-3">
          <%= render ClaperWeb.Admin.SharedView, "_form_field.html",
            form: f,
            field: :active,
            type: :checkbox,
            label: "Active Status",
            description: "When active, the event is visible and accessible to attendees."
          %>
        </div>

        <div class="sm:col-span-6">
          <%= render ClaperWeb.Admin.SharedView, "_form_field.html",
            form: f,
            field: :description,
            type: :textarea,
            label: "Description",
            rows: 3,
            description: "Brief description of the event visible to attendees."
          %>
        </div>
      </div>
    </div>
    
    <div class="px-4 py-3 bg-gray-50 text-right sm:px-6">
      <button type="submit" class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
        <i class="fas fa-save mr-2"></i> Save Changes
      </button>
    </div>
  <% end %>
</div>

<div class="mt-6">
  <div class="bg-white shadow overflow-hidden sm:rounded-lg">
    <div class="px-4 py-5 sm:px-6">
      <h3 class="text-lg leading-6 font-medium text-gray-900">Danger Zone</h3>
      <p class="mt-1 max-w-2xl text-sm text-gray-500">Destructive actions for this event.</p>
    </div>
    <div class="border-t border-gray-200 px-4 py-5 sm:p-6">
      <div class="space-y-6">
        <div>
          <h3 class="text-sm font-medium text-gray-900">Delete Event</h3>
          <div class="mt-2 max-w-xl text-sm text-gray-500">
            <p>Once you delete this event, there is no going back. Please be certain.</p>
          </div>
          <div class="mt-3">
            <button 
              type="button" 
              data-modal-target="delete-event-modal"
              class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
              <i class="fas fa-trash-alt mr-2"></i> Delete Event
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%= render ClaperWeb.Admin.SharedView, "_modal.html", 
  id: "delete-event-modal",
  title: "Delete Event",
  content: "Are you sure you want to delete this event? This action cannot be undone. All associated data will be permanently removed.",
  confirm_action: "Delete",
  confirm_path: Routes.admin_event_path(@conn, :delete, @event),
  confirm_method: :delete,
  confirm_class: "bg-red-600 hover:bg-red-700",
  cancel_action: "Cancel",
  icon: "fa-exclamation-triangle",
  conn: @conn
%>
