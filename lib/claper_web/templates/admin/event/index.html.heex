<div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between">
  <h2 class="text-lg font-medium text-gray-900">Events List</h2>
</div>

<%= render ClaperWeb.Admin.SharedView, "_search_filter.html", 
  search_path: Routes.admin_event_path(@conn, :index),
  search_placeholder: "Search by name, code...",
  search_value: @search,
  filters: [
    %{name: "status", label: "Status", options: [
      {"All Status", ""},
      {"Upcoming", "upcoming"},
      {"Past", "past"},
      {"Active", "active"}
    ]}
  ],
  status: @status,
  clear_path: Routes.admin_event_path(@conn, :index),
  new_path: Routes.admin_event_path(@conn, :new),
  new_label: "Add Event",
  export_csv_path: Routes.admin_event_path(@conn, :index, format: "csv"),
  conn: @conn
%>

<!-- Advanced filters (collapsible) -->
<div class="mb-6 bg-white shadow rounded-lg overflow-hidden">
  <div class="px-4 py-3 border-b border-gray-200">
    <button type="button" id="advanced-filters-toggle" class="text-sm text-indigo-600 hover:text-indigo-500 focus:outline-none flex items-center">
      <i class="fas fa-sliders-h mr-1"></i> Advanced Filters
      <i class="fas fa-chevron-down ml-1 text-xs"></i>
    </button>
  </div>
  
  <div id="advanced-filters" class="hidden px-4 py-4 bg-gray-50">
    <form action={Routes.admin_event_path(@conn, :index)} method="get" class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <!-- Preserve existing filters -->
      <input type="hidden" name="search" value={@search}>
      <input type="hidden" name="status" value={@status}>
      
      <div>
        <%= render ClaperWeb.Admin.SharedView, "_form_field.html",
          form: nil,
          field: :start_date,
          type: :date,
          label: "Start Date",
          value: @start_date,
          name: "start_date",
          id: "start_date"
        %>
      </div>
      
      <div>
        <%= render ClaperWeb.Admin.SharedView, "_form_field.html",
          form: nil,
          field: :end_date,
          type: :date,
          label: "End Date",
          value: @end_date,
          name: "end_date",
          id: "end_date"
        %>
      </div>
      
      <div class="flex items-end">
        <button type="submit" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
          <i class="fas fa-filter mr-2"></i> Apply Filters
        </button>
      </div>
    </form>
  </div>
</div>

<%= render ClaperWeb.Admin.SharedView, "_table.html", 
  conn: @conn,
  items: @events,
  columns: [
    %{label: "Name", field: :name},
    %{label: "Code", field: :code},
    %{label: "Creator", field: :user, value_fn: fn event -> event.user.email end},
    %{label: "Scheduled At", field: :scheduled_at, value_fn: fn event -> 
      if event.scheduled_at do
        NaiveDateTime.to_string(event.scheduled_at)
      else
        "Not scheduled"
      end
    end},
    %{label: "Status", field: :status, value_fn: fn event -> 
      cond do
        event.scheduled_at && NaiveDateTime.compare(event.scheduled_at, NaiveDateTime.utc_now()) == :gt ->
          {:badge, "Upcoming", "yellow"}
        event.scheduled_at && NaiveDateTime.compare(event.scheduled_at, NaiveDateTime.utc_now()) == :lt ->
          {:badge, "Past", "gray"}
        event.active ->
          {:badge, "Active", "green"}
        true ->
          {:badge, "Inactive", "gray"}
      end
    end}
  ],
  actions: fn event -> [
    %{label: "View", icon: "eye", path: Routes.admin_event_path(@conn, :show, event), color: "indigo"},
    %{label: "Edit", icon: "edit", path: Routes.admin_event_path(@conn, :edit, event), color: "indigo"},
    %{label: "Export", icon: "download", path: Routes.admin_event_path(@conn, :export, event, format: "csv"), color: "indigo"},
    %{label: "Delete", icon: "trash", path: "#", color: "red", modal_id: "delete-event-#{event.id}"}
  ] end,
  empty_message: "No events found"
%>

<%= for event <- @events do %>
  <%= render ClaperWeb.Admin.SharedView, "_modal.html", 
    id: "delete-event-#{event.id}",
    title: "Delete Event",
    content: "Are you sure you want to delete the event '#{event.name}'? This action cannot be undone.",
    confirm_action: "Delete",
    confirm_path: Routes.admin_event_path(@conn, :delete, event),
    confirm_method: :delete,
    confirm_class: "bg-red-600 hover:bg-red-700",
    cancel_action: "Cancel",
    icon: "fa-exclamation-triangle",
    conn: @conn
  %>
<% end %>

<!-- Pagination -->
<%= if @total_pages > 1 do %>
  <div class="mt-6 flex items-center justify-between">
    <div class="text-sm text-gray-700">
      Showing <span class="font-medium"><%= (@page_number - 1) * @page_size + 1 %></span> to <span class="font-medium"><%= min(@page_number * @page_size, @total_entries) %></span> of <span class="font-medium"><%= @total_entries %></span> results
    </div>
    <div class="flex-1 flex justify-between sm:justify-end">
      <%= if @page_number > 1 do %>
        <a href={Routes.admin_event_path(@conn, :index, page: @page_number - 1, search: @search, status: @status, start_date: @start_date, end_date: @end_date, creator_id: @creator_id)} class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
          <i class="fas fa-chevron-left mr-2"></i> Previous
        </a>
      <% end %>
      <%= if @page_number < @total_pages do %>
        <a href={Routes.admin_event_path(@conn, :index, page: @page_number + 1, search: @search, status: @status, start_date: @start_date, end_date: @end_date, creator_id: @creator_id)} class="ml-3 relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50">
          Next <i class="fas fa-chevron-right ml-2"></i>
        </a>
      <% end %>
    </div>
  </div>
<% end %>

<!-- JavaScript for Advanced Filters Toggle -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const advancedFiltersToggle = document.getElementById('advanced-filters-toggle');
    const advancedFilters = document.getElementById('advanced-filters');
    
    if (advancedFiltersToggle && advancedFilters) {
      advancedFiltersToggle.addEventListener('click', function() {
        advancedFilters.classList.toggle('hidden');
        
        // Toggle chevron icon
        const chevron = advancedFiltersToggle.querySelector('.fa-chevron-down');
        if (chevron) {
          chevron.classList.toggle('fa-chevron-down');
          chevron.classList.toggle('fa-chevron-up');
        }
      });
    }
  });
</script>
